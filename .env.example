# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY / VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key
VITE_GOOGLE_MAPS_API_KEY=""

# Admin authentication credentials for /admin dashboard
ADMIN_EMAIL="info@clsfae.com"
ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="CHANGE_ME_SESSION_SECRET"

# Company inbox and optional SMTP configuration for dispatching portal enquiries to info@clsfae.com
NOTIFICATION_EMAIL="info@clsfae.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_FROM="info@clsfae.com"
SMTP_USER=""
SMTP_PASS=""
